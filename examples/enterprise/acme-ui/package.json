    "publish": "pnpm publish dist/acme/ui-core --no-git-checks && pnpm publish dist/acme/ui-forms --no-git-checks"
  },
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
